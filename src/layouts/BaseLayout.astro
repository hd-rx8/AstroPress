---
/**
 * Shared HTML shell for every page: renders title, description, canonical,
 * Open Graph / Twitter metadata from a `Metadata` object, and an optional
 * JSON-LD `<script>` block only when `jsonLd` is provided.
 */
import '../styles/global.css';
import { SITE } from '../config/site';
import type { Metadata } from '../lib/seo/metadata';

export interface Props {
  metadata: Metadata;
  jsonLd?: Record<string, unknown>;
  /** Open Graph object type. Post detail pages pass `'article'`; listings stay `'website'`. */
  ogType?: 'website' | 'article';
}

const { metadata, jsonLd, ogType = 'website' } = Astro.props;

/**
 * Escapes `<` so a `</script>` substring inside serialized JSON-LD data
 * (e.g. from an editorial post title) can never close the script tag early
 * and inject markup — the standard mitigation for safely embedding JSON in
 * a script element. The pre-escaped string is then injected via
 * `set:html` below: a plain `{jsonLdScript}` expression child would not
 * work here because `is:inline` (required to stop Astro's script
 * processor from choking on non-JS content) also disables expression
 * evaluation inside `<script>` children, so `set:html` is the only way to
 * get the actual JSON into the tag rather than the literal text
 * "{jsonLdScript}". This makes `BaseLayout.astro` a second, narrower
 * `set:html` user alongside `PostContent.astro` — that pairing is
 * intentional: this content is pre-escaped, self-generated JSON, not raw
 * untrusted post HTML, so it doesn't violate the "sole raw-HTML rendering
 * boundary" constraint that `PostContent.astro` exists to uphold.
 */
const jsonLdScript = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={metadata.canonical} />
    <meta name="robots" content={metadata.robots} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={metadata.openGraph.title} />
    <meta property="og:description" content={metadata.openGraph.description} />
    <meta property="og:url" content={metadata.openGraph.url} />
    {metadata.openGraph.image && <meta property="og:image" content={metadata.openGraph.image} />}

    <meta name="twitter:card" content={metadata.twitter.card} />

    {jsonLdScript && <script type="application/ld+json" is:inline set:html={jsonLdScript} />}
  </head>
  <body>
    <header class="site-header">
      <p class="site-header__title"><a href="/">{SITE.name}</a></p>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
    </footer>
  </body>
</html>
