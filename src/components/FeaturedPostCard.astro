---
/**
 * Featured Post Card.
 *
 * Prominent, asymmetric card designed for the blog index and homepage hero
 * section. Renders a high-resolution featured image, category pills, date,
 * bold headline, summary excerpt, and author metadata.
 */
import { Image } from 'astro:assets';
import { postPath } from '../lib/routes';
import type { Post } from '../lib/wordpress/normalizers';

export interface Props {
  post: Post;
  badgeText?: string;
}

const { post, badgeText } = Astro.props;
const href = postPath(post.slug);
const formattedDate = new Date(post.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const defaultCategories = post.categories && post.categories.length > 0
  ? post.categories
  : [{ id: 0, name: badgeText || 'Destaque', slug: 'destaque' }, { id: 1, name: 'WordPress', slug: 'wordpress' }];
---

<article class="featured-card">
  <div class="featured-card__media">
    <a href={href} tabindex="-1" aria-hidden="true" class="featured-card__media-link">
      {
        post.featuredImage?.width && post.featuredImage?.height ? (
          <Image
            class="featured-card__image"
            src={post.featuredImage.url}
            alt={post.featuredImage.alt}
            width={post.featuredImage.width}
            height={post.featuredImage.height}
            widths={[480, 768, 1024, 1400]}
            sizes="(max-width: 900px) 100vw, 50vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <img
            class="featured-card__image"
            src="/images/rocket-cover.jpg"
            alt="Ilustração moderna de foguete em lançamento"
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
          />
        )
      }
    </a>
  </div>

  <div class="featured-card__content">
    <div class="featured-card__meta-top">
      <div class="featured-card__badges">
        {defaultCategories.map((cat, idx) => (
          <span class={`badge ${idx % 2 === 0 ? 'badge--amber' : 'badge--purple'}`}>
            {cat.name}
          </span>
        ))}
      </div>
      <time datetime={post.date} class="featured-card__date">{formattedDate}</time>
    </div>

    <h2 class="featured-card__title">
      <a href={href}>{post.title}</a>
    </h2>

    {post.excerpt && <p class="featured-card__excerpt">{post.excerpt}</p>}

    <div class="featured-card__footer">
      <a href={href} class="featured-card__cta">
        <span>Ler Artigo</span>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
        </svg>
      </a>

      {post.author && (
        <div class="card-author">
          <div class="card-author__avatar">
            {post.author.name.charAt(0).toUpperCase()}
          </div>
          <div class="card-author__info">
            <span class="card-author__name">{post.author.name}</span>
            <span class="card-author__role">Autor</span>
          </div>
        </div>
      )}
    </div>
  </div>
</article>
