---
/**
 * Modern Post Summary Card.
 *
 * Designed with category pill badges, responsive image, bold typography,
 * excerpt, and author avatar footer matching modern SaaS / editorial standards.
 */
import { Image } from 'astro:assets';
import { postPath } from '../lib/routes';
import type { Post } from '../lib/wordpress/normalizers';

export interface Props {
  post: Post;
  badgeText?: string;
}

const { post, badgeText } = Astro.props;
const href = postPath(post.slug);
const formattedDate = new Date(post.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const defaultCategories = post.categories && post.categories.length > 0
  ? post.categories
  : [{ id: 0, name: badgeText || 'Artigo', slug: 'artigo' }];
---

<li class="modern-card">
  <div class="modern-card__media">
    <a href={href} tabindex="-1" aria-hidden="true" class="modern-card__media-link">
      {
        post.featuredImage?.width && post.featuredImage?.height ? (
          <Image
            class="modern-card__image"
            src={post.featuredImage.url}
            alt={post.featuredImage.alt}
            width={post.featuredImage.width}
            height={post.featuredImage.height}
            widths={[360, 540, 720, 1080]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <img
            class="modern-card__image"
            src="/images/rocket-cover.jpg"
            alt="Ilustração moderna de foguete em lançamento"
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
          />
        )
      }
    </a>
  </div>

  <div class="modern-card__body">
    <div class="modern-card__badges">
      {defaultCategories.slice(0, 2).map((cat, idx) => (
        <span class={`badge ${idx % 2 === 0 ? 'badge--amber' : 'badge--purple'}`}>
          {cat.name}
        </span>
      ))}
    </div>

    <h2 class="modern-card__title">
      <a href={href}>{post.title}</a>
    </h2>

    {post.excerpt && <p class="modern-card__excerpt">{post.excerpt}</p>}

    <div class="modern-card__footer">
      <div class="card-author">
        <div class="card-author__avatar">
          {post.author ? post.author.name.charAt(0).toUpperCase() : 'A'}
        </div>
        <div class="card-author__info">
          <span class="card-author__name">{post.author ? post.author.name : 'Equipe AstroPress'}</span>
          <span class="card-author__date">Atualizado em {formattedDate}</span>
        </div>
      </div>
    </div>
  </div>
</li>
