---
/**
 * A single post summary card used in listing grids (home, blog index,
 * paginated blog pages). Featured image, excerpt, and author are each
 * rendered only when present on the normalized `Post`.
 */
import { Image } from 'astro:assets';
import { postPath } from '../lib/routes';
import type { Post } from '../lib/wordpress/normalizers';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = postPath(post.slug);
const formattedDate = new Date(post.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li class="card">
  {
    post.featuredImage && (
      <a href={href} tabindex="-1" aria-hidden="true">
        {post.featuredImage.width && post.featuredImage.height ? (
          <Image
            class="card__image"
            src={post.featuredImage.url}
            alt={post.featuredImage.alt}
            width={post.featuredImage.width}
            height={post.featuredImage.height}
            widths={[360, 540, 720, 1080]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <img
            class="card__image"
            src={post.featuredImage.url}
            alt={post.featuredImage.alt}
            loading="lazy"
            decoding="async"
          />
        )}
      </a>
    )
  }

  <div class="card__body">
    <h2 class="card__title"><a href={href}>{post.title}</a></h2>
    <p class="card__meta">
      <time datetime={post.date}>{formattedDate}</time>
      {post.author && <> · {post.author.name}</>}
    </p>
    {post.excerpt && <p class="card__excerpt">{post.excerpt}</p>}
  </div>
</li>
