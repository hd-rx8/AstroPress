---
/**
 * Blog index: page 1 of the paginated post listing (served at `/blog/`).
 * Later pages live at `/blog/page/N/` — see `blog/page/[number].astro`.
 */
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildMetadata } from '../../lib/seo/metadata';
import { BLOG_PAGE_SIZE, getAllPosts, paginatePosts } from '../../lib/wordpress/posts';

const posts = await getAllPosts();
const { items, page, totalPages } = paginatePosts(posts, 1, BLOG_PAGE_SIZE);

const metadata = buildMetadata({
  title: 'Blog',
  path: '/blog/',
});
---

<BaseLayout metadata={metadata}>
  <h1>Blog</h1>
  <ul class="card-grid">
    {items.map((post) => <PostCard post={post} />)}
  </ul>
  <Pagination page={page} totalPages={totalPages} />
</BaseLayout>
