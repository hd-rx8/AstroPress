---
/**
 * Single post page with Previous & Next post navigation.
 * Every post is generated from the already-fetched,
 * already-normalized `getAllPosts()` collection via `getStaticPaths`.
 */
import { Image } from 'astro:assets';
import PostContent from '../../components/PostContent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postPath } from '../../lib/routes';
import type { Post } from '../../lib/wordpress';
import { getAllPosts, getJsonLdGraph, getSeoData } from '../../lib/wordpress';

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: index > 0 ? posts[index - 1] : undefined,
      nextPost: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

export interface Props {
  post: Post;
  prevPost?: Post;
  nextPost?: Post;
}

const { post, prevPost, nextPost } = Astro.props;

const metadata = getSeoData({
  title: post.title,
  description: post.excerpt,
  path: postPath(post.slug),
  imageUrl: post.featuredImage?.url || '/images/rocket-cover.jpg',
});

const jsonLd = getJsonLdGraph(post, metadata.canonical);

const formattedDate = new Date(post.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout metadata={metadata} jsonLd={jsonLd} ogType="article">
  <article class="prose">
    <header class="page-header">
      <div class="featured-card__badges" style="margin-bottom: 0.75rem;">
        {post.categories && post.categories.length > 0 ? (
          post.categories.map((cat, idx) => (
            <span class={`badge ${idx % 2 === 0 ? 'badge--amber' : 'badge--purple'}`}>
              {cat.name}
            </span>
          ))
        ) : (
          <span class="badge badge--amber">Artigo</span>
        )}
      </div>

      <h1 class="page-header__title">{post.title}</h1>
      <p class="page-header__meta">
        <time datetime={post.date}>{formattedDate}</time>
        {post.author && <> · Por <strong>{post.author.name}</strong></>}
      </p>

      <div class="page-header__image">
        {
          post.featuredImage?.width && post.featuredImage?.height ? (
            <Image
              src={post.featuredImage.url}
              alt={post.featuredImage.alt}
              width={post.featuredImage.width}
              height={post.featuredImage.height}
              widths={[480, 800, 1200]}
              sizes="(max-width: 800px) 100vw, 800px"
              loading="eager"
              decoding="async"
            />
          ) : (
            <img
              src="/images/rocket-cover.jpg"
              alt="Ilustração moderna de foguete em lançamento"
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
            />
          )
        }
      </div>
    </header>

    <PostContent html={post.content} />

    <footer class="post-footer">
      <nav class="post-nav" aria-label="Navegação entre Artigos">
        {prevPost ? (
          <a href={postPath(prevPost.slug)} class="post-nav__card post-nav__card--prev">
            <span class="post-nav__label">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
                <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
              </svg>
              <span>Artigo Anterior</span>
            </span>
            <strong class="post-nav__title">{prevPost.title}</strong>
          </a>
        ) : (
          <div class="post-nav__card post-nav__card--empty post-nav__card--prev">
            <span class="post-nav__label">Início</span>
            <span class="post-nav__title">Você está no primeiro artigo</span>
          </div>
        )}

        {nextPost ? (
          <a href={postPath(nextPost.slug)} class="post-nav__card post-nav__card--next">
            <span class="post-nav__label">
              <span>Próximo Artigo</span>
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
              </svg>
            </span>
            <strong class="post-nav__title">{nextPost.title}</strong>
          </a>
        ) : (
          <div class="post-nav__card post-nav__card--empty post-nav__card--next">
            <span class="post-nav__label">Fim</span>
            <span class="post-nav__title">Você está no último artigo</span>
          </div>
        )}
      </nav>

      <div class="post-footer__back">
        <a href="/blog/" class="btn btn--secondary">
          <span>&larr; Voltar para todos os artigos</span>
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
