---
/**
 * Generic WordPress page route. Every page is generated from the
 * already-fetched, already-normalized `getAllPages()` collection via
 * `getStaticPaths` — no per-slug fetch happens here. `getAllPages` already
 * asserts no page slug collides with a reserved root route (e.g. "blog")
 * before this route ever sees the collection.
 */
import PostContent from '../components/PostContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pagePath } from '../lib/routes';
import type { Page } from '../lib/wordpress';
import { getAllPages, getSeoData } from '../lib/wordpress';

export async function getStaticPaths() {
  const pages = await getAllPages();

  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

export interface Props {
  page: Page;
}

const { page } = Astro.props;

const metadata = getSeoData({
  title: page.title,
  description: page.excerpt,
  path: pagePath(page.slug),
});
---

<BaseLayout metadata={metadata}>
  <article class="prose">
    <header class="page-header">
      <span class="hero__badge">Página Institucional</span>
      <h1 class="page-header__title">{page.title}</h1>
      {page.excerpt && <p class="page-header__meta">{page.excerpt}</p>}
    </header>
    <PostContent html={page.content} />
  </article>
</BaseLayout>
