---
/**
 * Home page: Modern Hero introduction, Featured Post, and latest posts grid.
 */
import FeaturedPostCard from '../components/FeaturedPostCard.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { buildWebsiteJsonLd, getAllPosts, getSeoData } from '../lib/wordpress';

const posts = await getAllPosts();
const featuredPost = posts[0];
const recentPosts = posts.slice(1, SITE.homePostLimit);

const metadata = getSeoData({
  title: SITE.name,
  description: SITE.description,
  path: '/',
});

const jsonLd = buildWebsiteJsonLd();
---

<BaseLayout metadata={metadata} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero__badge">WordPress Headless + Astro 5</div>
    <h1 class="hero__title">Performance máxima e arquitetura moderna para o seu WordPress</h1>
    <p class="hero__description">
      Gerencie todo o seu conteúdo no painel do WordPress e renderize páginas estáticas ultrarrápidas com Astro. Zero dependência de PHP em tempo de execução, Core Web Vitals impecáveis e total controle do frontend.
    </p>
    <div class="hero__actions">
      <a href="/blog/" class="btn btn--primary">
        <span>Explorar Artigos</span>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" style="margin-left: 0.35rem;">
          <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
        </svg>
      </a>
      <a
        href="https://github.com/hd-rx8/AstroPress-Headless-Starter"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--secondary"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="margin-right: 0.4rem;">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>Usar este Template</span>
      </a>
    </div>
  </section>

  {featuredPost && (
    <section class="blog-featured-section">
      <h2 class="section-label">Publicação Recente em Destaque</h2>
      <FeaturedPostCard post={featuredPost} />
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="section">
      <div class="section__header">
        <div>
          <h2 class="section__title">Artigos Recentes</h2>
          <p class="section__subtitle">Publicações sincronizadas diretamente da API REST do WordPress</p>
        </div>
        <a href="/blog/" class="section__link">Ver todos os artigos &rarr;</a>
      </div>
      <ul class="card-grid">
        {recentPosts.map((post) => <PostCard post={post} />)}
      </ul>
    </section>
  )}
</BaseLayout>
