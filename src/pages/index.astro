---
/**
 * Home page: shows the most recent posts (not the full blog listing).
 */
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { buildWebsiteJsonLd, getAllPosts, getSeoData } from '../lib/wordpress';

const posts = await getAllPosts();
const recentPosts = posts.slice(0, SITE.homePostLimit);

const metadata = getSeoData({
  title: SITE.name,
  description: SITE.description,
  path: '/',
});

const jsonLd = buildWebsiteJsonLd();
---

<BaseLayout metadata={metadata} jsonLd={jsonLd}>
  <h1>{SITE.name}</h1>
  <ul class="card-grid">
    {recentPosts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>

